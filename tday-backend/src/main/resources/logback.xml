<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="SENTRY" class="io.sentry.logback.SentryAppender">
        <!--
            Left to its own devices the appender starts a Sentry client from SENTRY_DSN the moment
            logging initialises, which is before main() builds the gated one and so bypasses the
            admin's on/off switch. A DSN ending in _IS_UNDEFINED is the appender's own signal to
            skip that; BackendSentry is the only place the SDK starts.
        -->
        <options>
            <dsn>SENTRY_DSN_IS_UNDEFINED</dsn>
        </options>
        <minimumEventLevel>ERROR</minimumEventLevel>
        <!-- INFO and WARN lines carry user ids, request paths and push endpoints. -->
        <minimumBreadcrumbLevel>ERROR</minimumBreadcrumbLevel>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="SENTRY"/>
    </root>
    <logger name="Exposed" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="io.ktor" level="INFO"/>
</configuration>
