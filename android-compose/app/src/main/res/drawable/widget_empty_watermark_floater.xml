<?xml version="1.0" encoding="utf-8"?><!-- Floater widget watermark: the shared lucide leaf (same glyph as the floater screen), mirrored
     so it points the same way as the iOS "leaf" symbol; rotation -7 matches the other widget
     watermarks. The mirror is baked into the path data (x -> 24 - x) rather than a negative group
     scale, and the strokes are opaque: the 10% weight comes from FloaterWidgetWatermark's alpha
     through setImageAlpha, the same route the list widgets' Lucide glyphs take. Some launchers drew
     nothing for the earlier form, which carried both a scaleX="-1" group and a baked strokeAlpha. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="180dp"
    android:height="180dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-7">
        <path
            android:pathData="M13,20A7,7 0 0 0 14.2,6.1C8.5,5 7,4.48 5,2c-1,2 -2,4.18 -2,8 0,5.5 4.78,10 10,10Z"
            android:strokeWidth="2"
            android:strokeColor="@color/tday_widget_floater_accent"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M22,21c0,-3 -1.85,-5.36 -5.08,-6C14.5,14.52 12,13 11,12"
            android:strokeWidth="2"
            android:strokeColor="@color/tday_widget_floater_accent"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
