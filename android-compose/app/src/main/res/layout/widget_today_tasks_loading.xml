<?xml version="1.0" encoding="utf-8"?>
<!--
  initialLayout for the medium/large Today widget: what a REAL placed widget shows in the gap
  before Glance's first composition lands (fresh add, and after a reboot until the app process
  starts). It must never contain sample tasks — widget_today_tasks_preview.xml has those, and
  it belongs to previewLayout (the picker) only. Showing invented tasks on someone's home
  screen reads as real data.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="13dp"
    android:paddingBottom="11dp">

    <!-- Mirrors the composed header (17sp bold) so the widget doesn't visibly reflow once
         the real content arrives. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:fontFamily="@font/nunito_app"
        android:maxLines="1"
        android:text="@string/widget_today_tasks_title"
        android:textColor="@color/tday_widget_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/nunito_app"
        android:maxLines="1"
        android:text="@string/widget_loading"
        android:textColor="@color/tday_widget_on_surface_variant"
        android:textSize="13sp"
        android:textStyle="bold" />
</FrameLayout>
