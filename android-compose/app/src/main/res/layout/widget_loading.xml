<?xml version="1.0" encoding="utf-8"?>
<!--
  initialLayout for the SMALL (2x2) widgets. No title here on purpose: the composed small
  header leads with the count rather than the title (see TaskWidgetMetrics.COMPACT), so a bare
  centred message is the honest analogue. The medium/large sizes use the per-widget
  widget_*_tasks_loading.xml, which can afford the title.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/nunito_app"
        android:maxLines="1"
        android:text="@string/widget_loading"
        android:textColor="@color/tday_widget_on_surface_variant"
        android:textSize="13sp"
        android:textStyle="bold" />
</FrameLayout>
