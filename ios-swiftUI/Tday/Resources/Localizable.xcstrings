        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floater tiada tarikh akhir — catat satu dan ia akan menunggu sehingga anda bersedia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
