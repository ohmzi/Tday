    "Floaters have no due date — write one down and it will wait until you are ready." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floater haben kein Fälligkeitsdatum – notiere einen, er wartet, bis du bereit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los flotantes no tienen fecha límite: anota uno y esperará hasta que estés listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les flottantes n'ont pas d'échéance : notez-en une, elle attendra que vous soyez prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
