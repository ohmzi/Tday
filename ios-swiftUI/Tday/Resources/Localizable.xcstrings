        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was du hinzufügst, erscheint hier – egal an welchem Datum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que añadas aparece aquí, sea cual sea su fecha."
          }
