          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre app requiert une version de serveur plus récente. Le serveur est en v%@. Veuillez contacter votre administrateur pour mettre à jour le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
