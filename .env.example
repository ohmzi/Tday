# ========================
# Network / Docker Compose
# ========================
# These two variables live in the PROJECT ROOT .env file (next to docker-compose.yaml).
# Docker Compose reads them for port binding. They are NOT passed into the container.
#
# Network binding — controls whether T'Day is accessible from external IPs.
#   127.0.0.1 = localhost only (DEFAULT, RECOMMENDED)
#               Access the app through a reverse proxy or Cloudflare Tunnel for HTTPS.
#   0.0.0.0   = allow external access over HTTP (NOT RECOMMENDED for production)
#               Only use for local development or trusted LAN environments.
# TDAY_HOST_BIND=127.0.0.1
#
# Host port mapped to the backend container's port 8080.
# TDAY_HOST_PORT=2525
#
# Backend image. Defaults to ghcr.io/ohmzi/tday:latest — the image CI publishes for
# every release — so `docker compose up -d` deploys a released build and never a
# working-tree one. scripts/deploy-release.sh sets this to the exact :v<version> tag
# from version.json. To build from your checkout instead, use the build override:
#   docker compose -f docker-compose.yaml -f docker-compose.build.yaml up -d --build
# TDAY_BACKEND_IMAGE=ghcr.io/ohmzi/tday:latest
#
# Container timezone (IANA name, e.g. America/New_York). Defaults to UTC and
# should normally be left as UTC. T'Day stores every task time in UTC and shows
# it to each user in THEIR OWN device timezone, so this setting does NOT change
# task due times, overdue calculation, or reminders — it only affects the
# server's log timestamps. Read by Docker Compose and passed into the backend
# container.
# TZ=UTC
#
# NOTE (reverse proxy / NAS): when T'Day sits behind nginx / Traefik / Caddy /
# Cloudflare, the proxy MUST forward the real client IP via one of
# `cf-connecting-ip`, `x-forwarded-for`, or `x-real-ip`. Without it, every
# request appears to come from the proxy and the per-IP auth/registration
# limits collapse onto a single bucket.

# ========================
# Environment & App Config
# ========================
# Generate with: openssl rand -base64 32
CRONJOB_SECRET=CHANGE_ME_WITH_A_RANDOM_32_BYTE_SECRET
# Application environment. Controls production-only behavior such as secure cookies and HSTS.
TDAY_ENV=development
# Optional comma-separated origins to allow for credentialed cross-origin browser requests.
# Leave empty for same-origin only.
CORS_ALLOWED_ORIGINS=
# Web Push (VAPID) keypair — required for browser push notifications. Without
# these, enabling notifications fails with "VAPID key not available".
# Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: load secrets from files (Docker/Kubernetes secret mounts).
# AUTH_SECRET_FILE=/run/secrets/auth_secret
# CRONJOB_SECRET_FILE=/run/secrets/cronjob_secret
# DATABASE_URL_FILE=/run/secrets/database_url

# ========================
# Sentry Telemetry
# ========================
# Backend, Android, and iOS Sentry DSN. Leave blank to disable telemetry.
SENTRY_DSN=
# Web Sentry DSN exposed to Vite builds. Leave blank to disable web telemetry.
VITE_SENTRY_DSN=
# Optional trace sampling rates from 0.0 to 1.0. Production defaults to 0.2.
SENTRY_TRACES_SAMPLE_RATE=0.2
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
# Auth token for source-context / source-map uploads during CI builds.
# SENTRY_AUTH_TOKEN=

# ========================
# AI Summaries (Local)
# ========================
# Leave blank for logic-only backend summaries without Ollama.
# To enable local AI summaries with Docker Compose, set this to http://ollama:11434
# and start Compose with: docker compose --profile ai up -d
OLLAMA_URL=
# Tiny model recommended for fast task summaries when Ollama is enabled. Must be a
# real Ollama tag your runtime can pull (see https://ollama.com/library).
OLLAMA_MODEL=qwen2.5:0.5b
# Timeout for model requests in milliseconds.
OLLAMA_TIMEOUT_MS=15000

# ========================
# Authentication
# ========================
# please generate your own secure 32-byte secret using openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_WITH_A_RANDOM_32_BYTE_SECRET
# PBKDF2 iterations used for credential hashing.
AUTH_PBKDF2_ITERATIONS=310000
# Rolling inactivity window for persistent web auth (seconds). Default 30 days.
AUTH_SESSION_MAX_AGE_SEC=2592000
# Absolute session cap from the original login time (seconds). Default 90 days.
AUTH_SESSION_ABSOLUTE_MAX_AGE_SEC=7776000
# Renew the session cookie when this many seconds or fewer remain. Default 7 days.
AUTH_SESSION_RENEW_THRESHOLD_SEC=604800
# Optional RSA private key (PKCS8 PEM) for client-side credential envelope encryption.
# When unset, the server generates an ephemeral key at startup (works on single-instance setups).
AUTH_CREDENTIALS_PRIVATE_KEY=
# AUTH_CREDENTIALS_PRIVATE_KEY_FILE=/run/secrets/auth_credentials_private_key

# ========================
# Database (Docker-ready)
# ========================
# JDBC-format URL used by Ktor / HikariCP.
# Keep as is unless docker-compose.yml is changed.
DATABASE_URL=postgresql://myuser:mypass@database:5432/mydb

# ========================
# Auth Hardening (Rate Limits / Lockout)
# ========================
# CSRF endpoint limiter (GET /api/auth/csrf)
AUTH_LIMIT_CSRF_WINDOW_SEC=60
AUTH_LIMIT_CSRF_MAX=40

# Credentials callback limiter (POST /api/auth/callback/credentials)
AUTH_LIMIT_CREDENTIALS_WINDOW_SEC=300
AUTH_LIMIT_CREDENTIALS_MAX=12

# Session limiter (GET /api/auth/session)
AUTH_LIMIT_SESSION_GET_WINDOW_SEC=60
AUTH_LIMIT_SESSION_GET_MAX=20

# Credential-key limiter (GET /api/auth/credentials-key)
AUTH_LIMIT_CREDENTIALS_KEY_WINDOW_SEC=60
AUTH_LIMIT_CREDENTIALS_KEY_MAX=20

# Registration limiter (POST /api/auth/register)
# Two per-IP tiers guard account creation: a short-window burst limit on top of
# the hourly hard cap below. NOTE: behind a reverse proxy the client IP comes
# from cf-connecting-ip / x-forwarded-for / x-real-ip, so the proxy MUST set one
# of those or every request collapses onto the proxy's own IP.
AUTH_LIMIT_REGISTER_WINDOW_SEC=3600
AUTH_LIMIT_REGISTER_MAX=6
# Short-window burst ceiling per IP (defaults: max 3 sign-ups per 10 minutes).
AUTH_LIMIT_REGISTER_BURST_WINDOW_SEC=600
AUTH_LIMIT_REGISTER_BURST_MAX=3

# App-layer request throttles
API_RATE_LIMIT_WINDOW_SEC=60
API_RATE_LIMIT_MAX=180
INFRA_RATE_LIMIT_WINDOW_SEC=60
INFRA_RATE_LIMIT_MAX=30
SUMMARY_RATE_LIMIT_WINDOW_SEC=60
SUMMARY_RATE_LIMIT_MAX=10
CHANGE_PASSWORD_RATE_LIMIT_WINDOW_SEC=300
CHANGE_PASSWORD_RATE_LIMIT_MAX=8
WS_RATE_LIMIT_WINDOW_SEC=60
WS_RATE_LIMIT_MAX=30

# Exponential lockout settings for repeated credential failures
AUTH_LOCKOUT_FAIL_THRESHOLD=5
AUTH_LOCKOUT_BASE_SEC=30
AUTH_LOCKOUT_MAX_SEC=1800
AUTH_LOCKOUT_RESET_SEC=86400
# Alerting thresholds (event log only; wire to external monitoring for paging).
AUTH_ALERT_IP_FAILURE_THRESHOLD=12
AUTH_ALERT_LOCKOUT_BURST_SEC=900
AUTH_SIGNAL_ANOMALY_WINDOW_SEC=86400

# ========================
# Adaptive Abuse Blocking
# ========================
# Registration stays OPEN and the reset lookup still reports whether a username
# exists. These settings only decide when one source has abused those paths
# enough to lose them for a while. Identity is the client IP (same header chain
# as the rate limits above), stored only as an HMAC — never the raw address.
#
# Two scopes, deliberately separate:
#   register — POST /api/auth/register
#   auth     — sign-in, login-challenge, security-question lookup and reset
# so a registration flood can never cost the owner their own sign-in.
#
# Rolling window the counters below are measured over.
ABUSE_SIGNAL_WINDOW_SEC=86400
# Register throttle/burst rejections from one source before it is blocked.
ABUSE_REGISTER_VIOLATION_MAX=5
# Accounts created from one source, still awaiting approval, before it is
# blocked. This is the strong signal: a real person registers once.
ABUSE_REGISTER_PENDING_MAX=3
# Lockout EPISODES (not individual wrong passwords) before the auth path blocks.
ABUSE_AUTH_LOCKOUT_MAX=3
# Escalation: 1h, then x24 per strike, capped. Blocks always expire on their own.
ABUSE_BLOCK_BASE_SEC=3600
ABUSE_BLOCK_MAX_SEC=604800
# Quiet period after which accumulated strikes fade back to zero.
ABUSE_STRIKE_DECAY_SEC=2592000
# RECOVERY: blocks never apply to a request carrying a valid session or API key,
# a successful sign-in clears the auth block for that address, an admin can lift
# any block via POST /api/admin/security/blocks/{id}/clear, and every block
# expires. To disable the feature entirely, set the three *_MAX knobs very high.

# ========================
# Security Alerts (admin push)
# ========================
# Qualifying events push to every approved ADMIN over the same channel as task
# reminders. At most one push per alert type per cooldown, no matter how many
# events arrive; the suppressed count rides along on the next one. The cooldown
# is stored in Postgres, so a restart loop cannot become an alert loop.
SECURITY_ALERT_COOLDOWN_SEC=900
# Sign-in-origin anomalies only alert once they repeat this many times.
SECURITY_ALERT_ANOMALY_MIN_COUNT=3
# One-time password-proof challenge TTL (seconds) for non-WebCrypto browser fallback.
AUTH_PASSWORD_PROOF_CHALLENGE_TTL_SEC=120
# Max in-memory active challenges before oldest entries are evicted.
AUTH_PASSWORD_PROOF_MAX_ACTIVE=5000

# ========================
# OAuth Providers (Optional)
# ========================
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ========================
# Field Encryption At Rest (Server-side)
# ========================
# Active key id + key material. Key can be base64 (32 bytes) or 64-char hex.
DATA_ENCRYPTION_KEY_ID=primary
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_encryption_key
# Optional key ring for rotation support: keyId:base64,keyId2:base64
DATA_ENCRYPTION_KEYS=
# DATA_ENCRYPTION_KEYS_FILE=/run/secrets/data_encryption_keys
# Optional Additional Authenticated Data tag.
DATA_ENCRYPTION_AAD=tday:v1
# DATA_ENCRYPTION_AAD_FILE=/run/secrets/data_encryption_aad
# Field encryption at rest is OPT-IN and OFF by default.
#
# Leaving DATA_ENCRYPTION_KEY empty is a supported configuration: the server boots and logs
# once that task titles and descriptions are stored as plaintext in Postgres. On a
# single-operator box that is a reasonable trade — anyone who can read the database already
# has the host, and this key would be sitting in this same file next to the volume.
#
# The threat it actually addresses is a database dump that LEAVES the host. Encrypting your
# backups (scripts/backup-database.sh) covers that better and cannot take the server down.
#
# Set this to true to make a missing key a hard startup failure instead — use it when you
# genuinely want the guarantee and would rather the server not start than store plaintext.
# Ignored outside production.
REQUIRE_ENCRYPTION_AT_REST=false

# ========================
# App-Backend Version Sync
# ========================
# The app version the server is compatible with (e.g. "1.12.0").
# When set (along with the encryption key), clients receive an encrypted
# compatibility payload in the probe response.
TDAY_APP_VERSION=0.7.4
# Hard version gate. When true AND TDAY_COMPATIBILITY_MODE=exact (the default,
# read from version.json), the server blocks EVERY /api/* request except
# /api/mobile/probe unless the app reports exactly TDAY_APP_VERSION — so the
# server-URL step succeeds but login fails with "Cannot reach server". Leave
# this false for self-hosting: the probe still reports version info so clients
# can prompt to update, but no request is hard-blocked. Only set true once your
# installed apps are pinned to the same version as the server.
TDAY_UPDATE_REQUIRED=true
# Compatibility comparison mode: "exact" (block any drift) or "min" (block only
# older apps). Defaults to version.json. Only enforced when TDAY_UPDATE_REQUIRED=true.
# TDAY_COMPATIBILITY_MODE=min
# 32-byte AES key, base64url-encoded. Same key must be compiled into the apps.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
TDAY_PROBE_ENCRYPTION_KEY=
# TDAY_PROBE_ENCRYPTION_KEY_FILE=/run/secrets/tday_probe_encryption_key

# ========================
# iOS Password AutoFill
# ========================
# Apple Developer Team ID used for Tday's canonical Apple Passwords webcredentials payload.
# Native iOS saves Tday credentials under tday.ohmz.cloud regardless of the connected server URL.
# Required in production for iOS Passwords / iCloud Keychain to trust the native app.
APPLE_TEAM_ID=THT5Z8K3TF
IOS_BUNDLE_ID=com.ohmz.tday.ios

# ========================
# Database Backups
# ========================
# Read by scripts/backup-database.sh and scripts/restore-database.sh, NOT by
# Docker Compose or the backend. Nothing here runs on its own: backups only
# happen once you schedule the script yourself (cron / systemd timer). Full
# guide, including the mandatory restore drill: docs/security/backups.md
#
# Where dumps are written. Default: <repo>/backups (created mode 700, self-ignored
# by git). Point this at a different physical disk if you can.
# TDAY_BACKUP_DIR=/srv/backups/tday
# Delete dumps older than this many days. 0 disables pruning. Default 30.
# TDAY_BACKUP_RETENTION_DAYS=30
# Encryption at rest for the dump. OPT-IN: none (default) | age | openssl.
# An unencrypted dump contains every password hash, API key and webhook secret.
# TDAY_BACKUP_ENCRYPTION=none
# age mode (preferred - public-key, so the server cannot decrypt its own backups).
# Create a keypair with: age-keygen -o ~/tday-backup-identity.txt
# TDAY_BACKUP_AGE_RECIPIENT=age1...
# TDAY_BACKUP_AGE_RECIPIENTS_FILE=/etc/tday-backup-recipients.txt
# Identity file used by restore-database.sh to DECRYPT an .age dump.
# TDAY_BACKUP_AGE_IDENTITY_FILE=/root/tday-backup-identity.txt
# openssl mode passphrase (AES-256-CBC, PBKDF2-SHA512, 600000 iterations).
# Never printed by the scripts. Do NOT put it in this repo's .env - use a
# separate root-owned file passed via --env-file. Lose it and the dump is gone.
# TDAY_BACKUP_PASSPHRASE=
# Refuse to keep a dump smaller than this many bytes (truncation guard). Default 1024.
# TDAY_BACKUP_MIN_BYTES=1024
# Overrides for non-standard setups.
# TDAY_BACKUP_COMPOSE_FILE=/path/to/docker-compose.yaml
# TDAY_BACKUP_DB_SERVICE=database
# TDAY_BACKUP_ENV_FILE=/etc/tday-backup.env
#
# NOTE: the dump does NOT contain DATA_ENCRYPTION_KEY / DATA_ENCRYPTION_KEYS /
# AUTH_SECRET. Encrypted columns restore as ciphertext and stay unreadable
# without the key that was current when the dump was taken - back up
# .env.docker alongside the database.
